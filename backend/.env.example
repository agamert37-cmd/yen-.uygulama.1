# HTTP port the panel itself listens on
PORT=4000

# Root directory where each imported project gets its own isolated subfolder
WORKSPACES_ROOT=./workspaces

# SQLite database file path
DB_PATH=./data/panel.sqlite

# "mock" simulates Docker/PM2 for local/sandbox development and demos.
# "real" talks to the actual Docker daemon and PM2 daemon - requires a real
# Linux host with Docker and PM2 installed and the docker socket accessible.
PANEL_DRIVER=mock

# Shared secret required (as `Authorization: Bearer <token>`) to call any
# /api/* route other than /api/health. Set this to a long random value.
PANEL_AUTH_TOKEN=change-me-to-a-long-random-secret

# Base domain for publishing running projects on their own subdomain
# (https://{subdomain}.PANEL_DOMAIN), reachable via a Cloudflare Tunnel you
# run separately (see README "Projeleri Herkese Açık Yayınlama"). Leave
# unset to disable publishing entirely (default for local/dev).
PANEL_DOMAIN=
